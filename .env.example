# =============================================================================
# AI RETARGETING — single-customer deployment
# =============================================================================
# One Vercel project = one agency. All state lives in GHL contact custom fields
# and notes. No database. Edit config.ts to change campaign cadence + templates.

# ---- Agency ----
AGENCY_NAME=Acme Agency
AGENCY_TIMEZONE=Europe/London
NOTIFICATION_EMAIL=ops@acme.com           # where ops alerts go (future)

# ---- Branding (rendered into the admin UI) ----
NEXT_PUBLIC_BRAND_NAME=Acme Agency
NEXT_PUBLIC_BRAND_LOGO_URL=https://cdn.example.com/acme.svg
NEXT_PUBLIC_BRAND_PRIMARY=14 165 233       # rgb triplet, space-separated, no commas
NEXT_PUBLIC_BRAND_PRIMARY_FG=255 255 255
NEXT_PUBLIC_BRAND_FONT=Inter

# ---- App URL (used in webhook URLs + email unsubscribe links) ----
NEXT_PUBLIC_APP_URL=https://calls.acme.com

# ---- GoHighLevel ----
GHL_LOCATION_ID=                          # GHL sub-account ID
GHL_PIT=                                  # GHL Private Integration Token
                                          # Scopes: contacts.write, customFields.write,
                                          #         tags.write, contacts.readonly

# ---- Twilio ----
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=+447700900123         # E.164 outbound + inbound number

# ---- Retell ----
RETELL_API_KEY=
RETELL_AGENT_ID=                          # the voice agent used for this campaign

# ---- Resend (email) ----
RESEND_API_KEY=
RESEND_FROM_EMAIL=hello@acme.com
RESEND_FROM_NAME=Acme Agency

# ---- Admin dashboard ----
ADMIN_PASSWORD=                           # HTTP basic-auth password. Leave blank in dev.

# ---- Vercel cron secret ----
# Used in vercel.json's cron URL: /api/tick?secret=<CRON_SECRET>
CRON_SECRET=
