# =============================================================================
# AI RETARGETING — single-customer deployment
# =============================================================================
# One Vercel project = one agency. All state lives in GHL contact custom fields
# and notes. SMS + email go through GHL's conversations API; voice goes through
# Retell. No Twilio creds, no Resend.

# ---- Agency ----
AGENCY_NAME=The Automate
AGENCY_TIMEZONE=Australia/Sydney
NOTIFICATION_EMAIL=chao@macaws.ai         # ops alerts (future use)

# ---- Branding (rendered into the admin UI) ----
NEXT_PUBLIC_BRAND_NAME=The Automate 
NEXT_PUBLIC_BRAND_LOGO_URL=https://cdn.example.com/acme.svg
NEXT_PUBLIC_BRAND_PRIMARY=14 165 233      # rgb triplet, space-separated, no commas
NEXT_PUBLIC_BRAND_PRIMARY_FG=255 255 255
NEXT_PUBLIC_BRAND_FONT=Inter

# ---- App URL (used in webhook URLs surfaced on /config) ----
NEXT_PUBLIC_APP_URL=https://facebook-ads-retargeting-theautomat.vercel.app/

# ---- GoHighLevel ----
GHL_LOCATION_ID=RvuFZZ3FVQEUJklKLL7T                          # GHL sub-account ID
GHL_PIT=pit-e9cb9252-a3c9-4c72-bd89-25b76f149f5c                                  # GHL Private Integration Token
                                          # Scopes needed:
                                          #   contacts.readonly, contacts.write
                                          #   customFields.readonly, customFields.write
                                          #   tags.write
                                          #   conversations.readonly, conversations.write
                                          #   conversations/message.write

# ---- Retell (voice) ----
RETELL_API_KEY=key_c3488acefac9117cb79ab2865de5
RETELL_AGENT_ID=agent_90f92e24cff9a14035932d9a10                          # the voice agent used for this campaign
RETELL_FROM_NUMBER=+61485007725          # E.164 number registered in Retell

# ---- Email From (optional) ----
GHL_EMAIL_FROM=info@email.theautomate.cloud                           # override sender; blank = GHL location default

# ---- Admin dashboard ----
ADMIN_PASSWORD=Cambridge83*_        # HTTP basic-auth password. Blank = open (dev only)

# ---- Vercel cron secret ----
CRON_SECRET=adkwid8e84()_*'#djwdi`1345ffs'                              # protects /api/tick from being hit by randos
