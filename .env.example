# =============================================================================
# AI RETARGETING — single-customer deployment
# =============================================================================
# One Vercel project = one agency. All state lives in GHL contact custom fields
# and notes. SMS + email go through GHL's conversations API; voice goes through
# Retell. No Twilio creds, no Resend.

# ---- Agency ----
AGENCY_NAME=Acme Agency
AGENCY_TIMEZONE=Europe/London
NOTIFICATION_EMAIL=ops@acme.com           # ops alerts (future use)

# ---- Branding (rendered into the admin UI) ----
NEXT_PUBLIC_BRAND_NAME=Acme Agency
NEXT_PUBLIC_BRAND_LOGO_URL=https://cdn.example.com/acme.svg
NEXT_PUBLIC_BRAND_PRIMARY=14 165 233      # rgb triplet, space-separated, no commas
NEXT_PUBLIC_BRAND_PRIMARY_FG=255 255 255
NEXT_PUBLIC_BRAND_FONT=Inter

# ---- App URL (used in webhook URLs surfaced on /config) ----
NEXT_PUBLIC_APP_URL=https://calls.acme.com

# ---- GoHighLevel ----
GHL_LOCATION_ID=                          # GHL sub-account ID
GHL_PIT=                                  # GHL Private Integration Token
                                          # Scopes needed:
                                          #   contacts.readonly, contacts.write
                                          #   customFields.readonly, customFields.write
                                          #   tags.write
                                          #   conversations.readonly, conversations.write
                                          #   conversations/message.write

# ---- Retell (voice) ----
RETELL_API_KEY=
RETELL_AGENT_ID=                          # the voice agent used for this campaign
RETELL_FROM_NUMBER=+447700900123          # E.164 number registered in Retell

# ---- Email From (optional) ----
GHL_EMAIL_FROM=                           # override sender; blank = GHL location default

# ---- Admin dashboard ----
ADMIN_PASSWORD=                           # HTTP basic-auth password. Blank = open (dev only)

# ---- Vercel cron secret ----
CRON_SECRET=                              # protects /api/tick from being hit by randos
