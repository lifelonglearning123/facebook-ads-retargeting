# =============================================================================
# AI RETARGETING — PER-AGENCY VERCEL CLONE ENV
# =============================================================================
# Each agency gets their own Vercel project with these vars set. The Supabase
# project is SHARED across all clones; tenancy is enforced by location_id+RLS.

# ---- Public app ----
NEXT_PUBLIC_APP_URL=https://calls.youragency.com
NEXT_PUBLIC_APP_NAME=Acme AI Callbacks

# ---- Tenancy ----
# Optional — pin this clone to a single agency. If unset, the app resolves the
# tenant from the logged-in user's location_id.
TENANT_LOCATION_ID=

# ---- Branding (full theme) ----
NEXT_PUBLIC_BRAND_NAME=Acme Agency
NEXT_PUBLIC_BRAND_LOGO_URL=https://cdn.example.com/acme-logo.svg
NEXT_PUBLIC_BRAND_PRIMARY=14 165 233       # rgb triplet, no commas
NEXT_PUBLIC_BRAND_PRIMARY_FG=255 255 255
NEXT_PUBLIC_BRAND_FONT=Inter

# ---- Shared Supabase (same values across all clones) ----
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...     # server-only

# ---- Per-clone email (Resend) ----
# Each agency configures their own Resend domain for white-labeled email-from.
RESEND_API_KEY=re_...
RESEND_FROM_EMAIL=hello@youragency.com
RESEND_FROM_NAME=Acme Agency

# ---- Stripe (shared platform account) ----
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_ID=price_...

# ---- Crypto ----
# 32-byte base64 secret used by lib/crypto.ts to encrypt agency API keys
# (Twilio, Retell, GHL PIT) at rest in Supabase.
ENCRYPTION_KEY=

# ---- Internal cron auth ----
# Shared secret between Supabase pg_cron HTTP requests and our dispatch route.
CRON_SECRET=
